<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" type="device"><diagram name="1 The Formula" id="1-The-Formula"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;The Omni Gap Formula&lt;/b&gt; — x* = Π_F [ Σ_k w_k · μ_k(x | E) ],  I = x* ± q₁₋α,  tag = FT(F, I, τ)" style="text;html=1;fontSize=18;fontFamily=Helvetica;fontColor=#18202C;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="30" as="geometry"/></mxCell><mxCell id="c2" value="One run of DETECT → PROCESS → RESPOND on one empty cell. Every path is tagged; nothing leaves blank. Code: formulas/omni_gap.py" style="text;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#5B6678;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1540" height="20" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;DETECT&lt;/b&gt;&lt;br&gt;the gap x and what surrounds it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=12;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="230" height="60" as="geometry"/></mxCell><mxCell id="c4" value="E — the measured values in the same record&lt;br&gt;&lt;i&gt;only measured values; never another fill&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="230" height="60" as="geometry"/></mxCell><mxCell id="c5" value="F — the feasible set&lt;br&gt;bounds + identities the record must obey&lt;br&gt;(revenue − cogs = gross)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="230" height="70" as="geometry"/></mxCell><mxCell id="c6" value="τ — decision tolerance&lt;br&gt;the error size that would change a decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="230" height="60" as="geometry"/></mxCell><mxCell id="c7" value="Parallel system(s) + mapping&lt;br&gt;which variables correspond (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;dashed=1;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="230" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;PROCESS&lt;/b&gt; — four evidence channels, one layer each" style="text;html=1;fontSize=13;fontFamily=Helvetica;fontColor=#18202C;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="500" height="24" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;P · Capsule prior&lt;/b&gt;&lt;br&gt;what this variable looks like across every prior record&lt;br&gt;&lt;i&gt;Layer I.G — all prior paths&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="330" y="150" width="250" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;S · Process structure&lt;/b&gt;&lt;br&gt;the variable's measured relation to the other values in this record (ridge)&lt;br&gt;&lt;i&gt;Layer 0 / I.C&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="330" y="250" width="250" height="80" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;R · Analogue&lt;/b&gt;&lt;br&gt;the nearest comparable records in the same system (k-NN)&lt;br&gt;&lt;i&gt;Layer I.G / II&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="330" y="350" width="250" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;C · Correspondence&lt;/b&gt;&lt;br&gt;the relation fitted in a PARALLEL system on its own standardized coordinates, applied here: the shape transfers, the scale does not&lt;br&gt;&lt;i&gt;Layer II, Axiom 10&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;dashed=1;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="330" y="450" width="250" height="100" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;w · weights&lt;/b&gt;&lt;br&gt;learned by hiding values that ARE known and measuring which channel recovers them (non-negative least squares)&lt;br&gt;&lt;i&gt;Capsule loop — every failed path integrated&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="640" y="250" width="250" height="110" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Π_F · condition on F&lt;/b&gt;&lt;br&gt;Gaussian conditioning on the identities; when one value survives the cell is FORCED (exact)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="950" y="250" width="230" height="110" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;q₁₋α · calibrated width&lt;/b&gt;&lt;br&gt;the (1−α) quantile of the errors on those hidden known values (split-conformal): the stated miss rate IS the measured miss rate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="640" y="400" width="250" height="100" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;RESPOND&lt;/b&gt; — a value for every open cell, with its tag" style="text;html=1;fontSize=13;fontFamily=Helvetica;fontColor=#18202C;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1230" y="110" width="340" height="24" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;forced-fill&lt;/b&gt;&lt;br&gt;identities leave one value: exact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1230" y="150" width="330" height="64" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;estimate&lt;/b&gt;&lt;br&gt;range within τ; act on it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1230" y="228" width="330" height="64" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;estimate/wide&lt;/b&gt;&lt;br&gt;range wider than τ; act with care; next measurement named" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1230" y="306" width="330" height="64" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;assumption/prior-only&lt;/b&gt;&lt;br&gt;nothing beats the base rate; the value IS the base rate, tagged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B8860B;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1230" y="384" width="330" height="64" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;conflict&lt;/b&gt;&lt;br&gt;the record contradicts itself — no value; measure this record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DCDC;strokeColor=#A33A3A;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1230" y="462" width="330" height="64" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;Every output carries&lt;/b&gt;&lt;br&gt;value · 90% range · tag · falsifier (observation + threshold) · the one measurement that would narrow it most" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3E8F1;strokeColor=#2B3A55;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="1230" y="560" width="330" height="90" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;TERMINATE&lt;/b&gt; (audit correction F-066)&lt;br&gt;never emit a value without its tag; never use a fill as an input to another fill" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DCDC;strokeColor=#A33A3A;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="330" y="640" width="400" height="80" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;LEARN · restart at a higher baseline&lt;/b&gt; (MMA step 12)&lt;br&gt;every measurement later revealed joins the calibration set; sealed predictions are scored and the learned widening is applied once n ≥ 9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3E8F1;strokeColor=#2B3A55;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="760" y="640" width="440" height="80" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Measured on real tables&lt;/b&gt; (formulas/benchmark.py)&lt;br&gt;Auto-MPG error 0.426 vs best standard method 0.448 · penguins 0.561 vs 0.584 · P&amp;L 0.234 vs 0.256&lt;br&gt;90% ranges held the truth 91–93% of the time · Correspondence: mammal brain mass across 3 orders of magnitude 1.04 → 0.60; sign-reversed control: weight 0, 'not supported'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1140" height="90" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;What it does not do&lt;/b&gt;&lt;br&gt;produce a number from a canon layer (the audit found zero such cases) · beat the best possible inference from the same information · fill a boundary gap (t → 0) where no prior, structure, analogue or trend exists" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1230" y="700" width="330" height="150" as="geometry"/></mxCell><mxCell id="c52" value="Derivation, not canon. Source: GFunnel Methodology (Omni Process) v5.1–v5.4, Cameron Garlick / GFunnel, github.com/GFunnel-Tech/methodology, CC BY 4.0. The formula is an adaptation; not endorsed by the author." style="text;html=1;fontSize=9;fontFamily=Helvetica;fontColor=#5B6678;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="1540" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c4" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c4" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c4" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c7" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c13" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c14" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c15" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c16" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="x*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c21" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c5" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="residuals" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c21" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c29" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c26" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c26" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c26" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c26" target="c36"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c26" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="c35" target="c43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c43" target="c46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c48" value="re-weight" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="c46" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="re-calibrate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="c46" target="c29"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 The Router" id="2-The-Router"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;When to run what&lt;/b&gt; — the decision an AI makes before loading anything (CLAUDE.md §1, §3)" style="text;html=1;fontSize=18;fontFamily=Helvetica;fontColor=#18202C;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;What does the user want?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2B3A55;strokeColor=#2B3A55;fontSize=13;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="260" height="60" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Understand&lt;/b&gt; a concept, layer, term" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="260" height="50" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Diagnose&lt;/b&gt; why something is stuck or failing; run a named algorithm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="380" y="160" width="260" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Estimate&lt;/b&gt; — a number not yet in the record: fill gaps, forecast, compare, narrow, calculate one system from another" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="380" y="270" width="260" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Both&lt;/b&gt;: diagnose, then put numbers on it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="380" y="400" width="260" height="50" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Contribute / audit / integrate&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="380" y="470" width="260" height="60" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Answer mode&lt;/b&gt;&lt;br&gt;load the one section (SECTIONS.md)&lt;br&gt;workflows/answer.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="720" y="75" width="280" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Full methodology&lt;/b&gt;&lt;br&gt;v5.1 by framework/algorithms.md → layer → algorithm, run literally, every step&lt;br&gt;workflows/run-algorithm.md (derive.md if none fits)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="720" y="150" width="280" height="90" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Instruments only&lt;/b&gt;&lt;br&gt;Variable Principle · Forecasting Algorithm · Layer ◇ step 2 · Forcing Test outcomes · Estimate Protocol&lt;br&gt;workflows/estimate.md&lt;br&gt;&lt;i&gt;do NOT load Layers I–VII content: 3–4× the time, no accuracy&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="720" y="255" width="280" height="120" as="geometry"/></mxCell><mxCell id="c16" value="run-algorithm.md, then estimate.md for every number the diagnosis leaves open" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="720" y="400" width="280" height="50" as="geometry"/></mxCell><mxCell id="c17" value="CONTRIBUTING.md · audit/ · docs/ai-integration.md&lt;br&gt;workflows/iterate.md · reality-audit.md · integrate.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="720" y="465" width="280" height="70" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Estimate mode → which tool, by the shape of the input&lt;/b&gt; (all in formulas/, standard library)" style="text;html=1;fontSize=13;fontFamily=Helvetica;fontColor=#18202C;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1000" height="24" as="geometry"/></mxCell><mxCell id="c26" value="a table with empty cells" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="615" width="280" height="50" as="geometry"/></mxCell><mxCell id="c27" value="omni_gap.py — OmniGap(cols, rows, identities, bounds, tolerance).fill()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="350" y="615" width="560" height="50" as="geometry"/></mxCell><mxCell id="c28" value="per cell: value · range · tag · falsifier · next measurement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="940" y="615" width="620" height="50" as="geometry"/></mxCell><mxCell id="c31" value="one quantity, several measurements that may disagree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="677" width="280" height="50" as="geometry"/></mxCell><mxCell id="c32" value="ledger.py — new / add / run / seal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="350" y="677" width="560" height="50" as="geometry"/></mxCell><mxCell id="c33" value="per gap: narrowed · conflict · held-open; the witness whose removal restores agreement; the precision a decisive measurement needs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="940" y="677" width="620" height="50" as="geometry"/></mxCell><mxCell id="c36" value="a situation and a request to predict its metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="739" width="280" height="50" as="geometry"/></mxCell><mxCell id="c37" value="forecast.py — new → fill every row → commit (the seal) → score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="350" y="739" width="560" height="50" as="geometry"/></mxCell><mxCell id="c38" value="two arms, every metric tagged; later: hit rate vs stated coverage, error per tag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="940" y="739" width="620" height="50" as="geometry"/></mxCell><mxCell id="c41" value="two systems that may correspond, one thin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="801" width="280" height="50" as="geometry"/></mxCell><mxCell id="c42" value="OmniGap(..., correspondences=[Correspondence(name, cols, rows, mapping)]) — pattern in correspondence_test.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="350" y="801" width="560" height="50" as="geometry"/></mxCell><mxCell id="c43" value="estimates in the thin system from the rich one; per column: held / not supported here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="940" y="801" width="620" height="50" as="geometry"/></mxCell><mxCell id="c46" value="a question in conversation, no file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="863" width="280" height="50" as="geometry"/></mxCell><mxCell id="c47" value="the protocol by hand — estimate.md §3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="350" y="863" width="560" height="50" as="geometry"/></mxCell><mxCell id="c48" value="the same card, written out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="940" y="863" width="620" height="50" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;Rule on every output&lt;/b&gt; (rule 5, amended 2026-10-20): never fill a variable silently; never refuse to fill one that has a prior, structure, analogue or trend. Tag: measured · forced · estimate · assumption · held-open · conflict. 'held-open' without a value only when all four are absent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B8860B;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1040" y="75" width="520" height="110" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Diagnose mode&lt;/b&gt; loads what the Estimate mode skips: Three Kingdoms, Hermetic principles, dynamic middle, gradient. They locate &lt;i&gt;why&lt;/i&gt; a process is stuck. They do not produce numbers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1040" y="205" width="520" height="80" as="geometry"/></mxCell><mxCell id="c53" value="Derivation, not canon. Source: GFunnel Methodology (Omni Process) v5.1–v5.4, Cameron Garlick / GFunnel, github.com/GFunnel-Tech/methodology, CC BY 4.0. The formula is an adaptation; not endorsed by the author." style="text;html=1;fontSize=9;fontFamily=Helvetica;fontColor=#5B6678;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="945" width="1540" height="40" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c2" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c2" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c2" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c2" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c3" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c4" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c5" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c6" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c7" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="c16" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="c16" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c32" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c36" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c37" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c41" target="c42"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c46" target="c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c47" target="c48"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 The Output Card" id="3-The-Output-Card"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;The anatomy of one tagged estimate&lt;/b&gt; — what every number the system emits looks like, and what each tag permits" style="text;html=1;fontSize=18;fontFamily=Helvetica;fontColor=#18202C;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;monthly_revenue_usd: 22 000 USD/month   [tag: estimate]&lt;/b&gt;&lt;br&gt;&lt;br&gt;range     : 17 500 – 27 500  (90%)&lt;br&gt;method    : prior (base rate for firms of this size) · structure (clients × average contract) · analogue (3 comparable firms) · trend (two earlier readings)&lt;br&gt;falsifier : refuted if the measured value falls outside 17 500 – 27 500&lt;br&gt;next      : measure the client count — expected to shrink this range ~40%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3E8F1;strokeColor=#2B3A55;fontSize=12;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="720" height="190" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;value&lt;/b&gt;&lt;br&gt;the best number the evidence supports. Always present unless the tag is conflict (or held-open after the four-part test)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="230" height="85" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;tag&lt;/b&gt;&lt;br&gt;how the value was made. One of six; see right." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B8860B;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="285" y="300" width="230" height="85" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;range + coverage&lt;/b&gt;&lt;br&gt;calibrated where there is history (the stated miss rate is the measured miss rate); judged where there is not, and it says which." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="530" y="300" width="230" height="85" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;method&lt;/b&gt;&lt;br&gt;which of the four channels fed it: prior · structure · analogue · trend (Forecasting Algorithm steps 3–6)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="230" height="85" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;falsifier&lt;/b&gt;&lt;br&gt;the observation and threshold that would prove it wrong (Layer ◇ step 2). Without it, it is a belief, not an estimate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DCDC;strokeColor=#A33A3A;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="285" y="400" width="230" height="85" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;next&lt;/b&gt;&lt;br&gt;the one measurement that would narrow it most (the Anti-Operation's conjugate gap)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3E8F1;strokeColor=#2B3A55;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="530" y="400" width="230" height="85" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;The six tags&lt;/b&gt; and what each one permits" style="text;html=1;fontSize=13;fontFamily=Helvetica;fontColor=#18202C;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="80" width="700" height="24" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;measured&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=12;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="820" y="115" width="130" height="78" as="geometry"/></mxCell><mxCell id="c11" value="taken from a source, with uncertainty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="960" y="115" width="360" height="78" as="geometry"/></mxCell><mxCell id="c12" value="&lt;i&gt;must carry:&lt;/i&gt; cite source and date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=10;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330" y="115" width="230" height="78" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;forced&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=12;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="820" y="207" width="130" height="78" as="geometry"/></mxCell><mxCell id="c14" value="follows by necessity from measured values (one candidate survives)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="960" y="207" width="360" height="78" as="geometry"/></mxCell><mxCell id="c15" value="&lt;i&gt;must carry:&lt;/i&gt; state the identities used" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=10;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330" y="207" width="230" height="78" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;estimate&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=12;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="820" y="299" width="130" height="78" as="geometry"/></mxCell><mxCell id="c17" value="calculated from stated evidence (prior · structure · analogue · trend), range calibrated where possible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="960" y="299" width="360" height="78" as="geometry"/></mxCell><mxCell id="c18" value="&lt;i&gt;must carry:&lt;/i&gt; value + range + method + falsifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=10;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330" y="299" width="230" height="78" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;assumption&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B8860B;fontSize=12;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="820" y="391" width="130" height="78" as="geometry"/></mxCell><mxCell id="c20" value="a value from judgement alone. PERMITTED — an unstated assumption is worse. Scored separately so its reliability is learned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="960" y="391" width="360" height="78" as="geometry"/></mxCell><mxCell id="c21" value="&lt;i&gt;must carry:&lt;/i&gt; value + range + falsifier + the word 'assumption'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=10;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330" y="391" width="230" height="78" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;held-open&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DCDC;strokeColor=#A33A3A;fontSize=12;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="820" y="483" width="130" height="78" as="geometry"/></mxCell><mxCell id="c23" value="NO value — allowed only when no prior, no structure, no analogue and no trend exists. 'I don't know' is not a reason; anything that has happened before has a prior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="960" y="483" width="360" height="78" as="geometry"/></mxCell><mxCell id="c24" value="&lt;i&gt;must carry:&lt;/i&gt; the reason, and what would narrow it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=10;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330" y="483" width="230" height="78" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;conflict&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DCDC;strokeColor=#A33A3A;fontSize=12;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="820" y="575" width="130" height="78" as="geometry"/></mxCell><mxCell id="c26" value="the evidence disagrees with itself beyond its stated errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="960" y="575" width="360" height="78" as="geometry"/></mxCell><mxCell id="c27" value="&lt;i&gt;must carry:&lt;/i&gt; the witnesses, and which one restores agreement if removed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=10;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1330" y="575" width="230" height="78" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Before 2026-10-20&lt;/b&gt; the protocol had three statuses (measured · derived · held open) and gave the AI no permitted form for a calculated estimate. Rule 5 read as 'refuse'; a user's forecast test showed the cost (missed numbers, 3–4× slower). The Estimate Protocol (substrate/2026-10-20-estimate-protocol.md) added the tags and the four-part test." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="720" height="110" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;The four-part test&lt;/b&gt; for omitting a value: 1 no prior · 2 no structure · 3 no analogue · 4 no trend. All four absent → held-open. Any one present → a value can be calculated and must be. The Big Bang's first moment passes. Next quarter's revenue does not." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B8860B;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="720" height="100" as="geometry"/></mxCell><mxCell id="c30" value="Derivation, not canon. Source: GFunnel Methodology (Omni Process) v5.1–v5.4, Cameron Garlick / GFunnel, github.com/GFunnel-Tech/methodology, CC BY 4.0. The formula is an adaptation; not endorsed by the author." style="text;html=1;fontSize=9;fontFamily=Helvetica;fontColor=#5B6678;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="850" width="1540" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 The Living Asset" id="4-The-Living-Asset"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;The Gap Ledger&lt;/b&gt; — the formula run continuously on open questions (formulas/ledger.py, LEDGER.md)" style="text;html=1;fontSize=18;fontFamily=Helvetica;fontColor=#18202C;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="30" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;add evidence&lt;/b&gt;&lt;br&gt;value · σ · independent method · source URL · publication date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0F3;strokeColor=#1F7A8C;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="280" height="90" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;run&lt;/b&gt;&lt;br&gt;group by independent method (one witness each) · combine by precision · χ² consistency test" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="350" y="90" width="280" height="90" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;status per gap&lt;/b&gt;&lt;br&gt;held-open (no evidence) · live (single witness) · narrowed (corroborated) · conflict" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF2DD;strokeColor=#5F7F22;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="280" height="90" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;on conflict&lt;/b&gt;&lt;br&gt;tension in σ · which witness, removed, restores agreement · the precision a decisive measurement needs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8DCDC;strokeColor=#A33A3A;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="970" y="90" width="280" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;movement logged&lt;/b&gt;&lt;br&gt;history.jsonl → REPORT.md: the Iteration Ledger written by the formula" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3E8F1;strokeColor=#2B3A55;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="1280" y="90" width="280" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;seal&lt;/b&gt;&lt;br&gt;freeze the current range as a prediction (date + hash); commit before adding evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B8860B;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="350" y="260" width="280" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;score&lt;/b&gt;&lt;br&gt;later measurements (publication date after the seal; never theory) score hit / miss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B8860B;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="660" y="260" width="280" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;learn&lt;/b&gt;&lt;br&gt;every scored case says how wide the range should have been; the widening factor is applied once n ≥ 9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3E8F1;strokeColor=#2B3A55;fontSize=11;fontFamily=Helvetica;arcSize=8;align=center;fontStyle=1;strokeWidth=2;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="970" y="260" width="280" height="80" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Seeded gaps (verified against the primary papers)&lt;/b&gt;&lt;br&gt;G-001 Hubble constant — conflict 4.9σ; removing either the CMB value or the Cepheid ladder restores agreement&lt;br&gt;G-002 neutron lifetime — conflict 4.4σ, beam vs bottle&lt;br&gt;G-003 primordial lithium-7 — conflict 4.0σ, theory vs halo stars&lt;br&gt;G-004 W boson mass — conflict 7.2σ; removing CDF alone restores agreement (p = 0.65)&lt;br&gt;G-005 the Big Bang's first moment — held-open by the four-part test (v5.4 Gap 1, proven-open)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="760" height="150" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;What the replay measured&lt;/b&gt;&lt;br&gt;Backtest seals at past dates held only 17% of later results against a stated 90%: published uncertainties at these frontiers understate real error by ~3.3× so far (6 cases). Real seals placed 2026-10-19; predictive power stays held open until they are scored." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="400" width="730" height="150" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Boundary gaps&lt;/b&gt; (no prior, no structure, no analogue, no trend) are narrowed only from their measurable side. The ledger never fills them. That is the one place 'held-open' without a value is the correct output." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B8860B;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="760" height="80" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Keeping it alive&lt;/b&gt;: ledger.py add … → run → seal → commit. Evidence date = publication date. Theory never scores a seal. One witness = one independent method." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3E8F1;strokeColor=#2B3A55;fontSize=11;fontFamily=Helvetica;arcSize=8;align=left;fontColor=#18202C;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="830" y="580" width="730" height="80" as="geometry"/></mxCell><mxCell id="c22" value="Derivation, not canon. Source: GFunnel Methodology (Omni Process) v5.1–v5.4, Cameron Garlick / GFunnel, github.com/GFunnel-Tech/methodology, CC BY 4.0. The formula is an adaptation; not endorsed by the author." style="text;html=1;fontSize=9;fontFamily=Helvetica;fontColor=#5B6678;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="30" y="760" width="1540" height="40" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c4" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="re-calibrate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="c13" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>