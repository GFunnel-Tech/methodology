lue="Team report + retro" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.7;arrowSize=0.04;fontSize=10;fontFamily=Helvetica;fillColor=#F5F6F8;strokeColor=#5B6678;" vertex="1" parent="1"><mxGeometry x="445" y="654" width="290" height="38" as="geometry"/></mxCell><mxCell id="c27" value="Hub reports; funnel &amp;amp; channel numbers (SAL-12, MKT-03)" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.7;arrowSize=0.04;fontSize=10;fontFamily=Helvetica;fillColor=#E6EBF1;strokeColor=#5B6678;" vertex="1" parent="1"><mxGeometry x="655" y="700" width="290" height="38" as="geometry"/></mxCell><mxCell id="c28" value="Work proposals digest (O-24 → O-T3)" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.7;arrowSize=0.04;fontSize=10;fontFamily=Helvetica;fillColor=#E6EBF1;strokeColor=#5B6678;" vertex="1" parent="1"><mxGeometry x="655" y="746" width="290" height="38" as="geometry"/></mxCell><mxCell id="c29" value="Owner Weekly Report + proposals to approve" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.7;arrowSize=0.04;fontSize=10;fontFamily=Helvetica;fillColor=#E6EBF1;strokeColor=#5B6678;" vertex="1" parent="1"><mxGeometry x="865" y="792" width="290" height="38" as="geometry"/></mxCell><mxCell id="c30" value="Time &amp;amp; energy review (G-07)" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.7;arrowSize=0.04;fontSize=10;fontFamily=Helvetica;fillColor=#E6EBF1;strokeColor=#5B6678;" vertex="1" parent="1"><mxGeometry x="655" y="838" width="500" height="38" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Monthly&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=11;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="904" width="140" height="158" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#C9D1DC;dashed=1;" vertex="1" parent="1"><mxGeometry x="170" y="904" width="1254" height="158" as="geometry"/></mxCell><mxCell id="c33" value="BEAS scorecard (O-04); financials (FIN-04, FIN-03); risk &amp;amp; vendors (STR-05, OPS-04)" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.7;arrowSize=0.04;fontSize=10;fontFamily=Helvetica;fillColor=#E6EBF1;strokeColor=#5B6678;" vertex="1" parent="1"><mxGeometry x="655" y="914" width="290" height="38" as="geometry"/></mxCell><mxCell id="c34" value="Monthly pack inside the Weekly Report" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.7;arrowSize=0.04;fontSize=10;fontFamily=Helvetica;fillColor=#E6EBF1;strokeColor=#5B6678;" vertex="1" parent="1"><mxGeometry x="865" y="960" width="290" height="38" as="geometry"/></mxCell><mxCell id="c35" value="Client BEAS + results reports (CS-06)" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.7;arrowSize=0.04;fontSize=10;fontFamily=Helvetica;fillColor=#F5F6F8;strokeColor=#5B6678;" vertex="1" parent="1"><mxGeometry x="655" y="1006" width="710" height="38" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Quarterly&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=11;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1072" width="140" height="112" as="geometry"/></mxCell><mxCell id="c37" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#C9D1DC;dashed=1;" vertex="1" parent="1"><mxGeometry x="170" y="1072" width="1254" height="112" as="geometry"/></mxCell><mxCell id="c38" value="Strategic plan (STR-03); compliance review (HRC-10)" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.7;arrowSize=0.04;fontSize=10;fontFamily=Helvetica;fillColor=#E6EBF1;strokeColor=#5B6678;" vertex="1" parent="1"><mxGeometry x="655" y="1082" width="500" height="38" as="geometry"/></mxCell><mxCell id="c39" value="Immersion reviews (CS-10)" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.7;arrowSize=0.04;fontSize=10;fontFamily=Helvetica;fillColor=#F5F6F8;strokeColor=#5B6678;" vertex="1" parent="1"><mxGeometry x="655" y="1128" width="710" height="38" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Per change&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=11;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="1194" width="140" height="66" as="geometry"/></mxCell><mxCell id="c41" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#C9D1DC;dashed=1;" vertex="1" parent="1"><mxGeometry x="170" y="1194" width="1254" height="66" as="geometry"/></mxCell><mxCell id="c42" value="Agent alignment review (G-05) before any new or expanded agent" style="shape=singleArrow;direction=east;whiteSpace=wrap;html=1;arrowWidth=0.7;arrowSize=0.04;fontSize=10;fontFamily=Helvetica;fillColor=#E6EBF1;strokeColor=#5B6678;" vertex="1" parent="1"><mxGeometry x="655" y="1204" width="500" height="38" as="geometry"/></mxCell><mxCell id="c43" value="Derivation, not canon. Source: GFunnel Methodology (Omni Process) v5.1–v5.3, Cameron Garlick / GFunnel, github.com/GFunnel-Tech/methodology, CC BY 4.0. Adapted into an agent operating model; not endorsed by the author." style="text;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#5B6678;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="1290" width="1200" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="4 · Work Suggestion Loop"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Work Suggestion Loop — the team proposes work from project signals" style="text;html=1;fontSize=20;fontStyle=1;fontFamily=Helvetica;fontColor=#18202C;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Agents never start unapproved work. They propose it with an expected outcome and a falsifier; the Owner decides; afterwards the result is checked against the prediction and the gap feeds the next scan." style="text;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#5B6678;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1000" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;1 · Signals&lt;/b&gt;&lt;br&gt;BEAS lowest cell (O-04) · stalls (O-08) · lowest funnel step (SAL-12) · clients' next step (CS-10) · risks (STR-05) · patterns (O-20) · open variables (G-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=10;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="300" height="110" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;2 · O-24 Work Suggestion Agent&lt;/b&gt;&lt;br&gt;scans weekly; writes proposal cards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EBF1;strokeColor=#4D5F7A;fontSize=11;fontFamily=Helvetica;arcSize=8;fontStyle=1;fontColor=#18202C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="140" width="260" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;3 · O-T3 Intelligence &amp;amp; Decision Lead&lt;/b&gt;&lt;br&gt;checks cards; ranks by dependency order; Four-Pillar check before any scale proposal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EBF1;strokeColor=#4D5F7A;fontSize=11;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="860" y="130" width="300" height="100" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;4 · O-23 Owner Liaison&lt;/b&gt;&lt;br&gt;proposals in the Owner Weekly Report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EBF1;strokeColor=#4D5F7A;fontSize=11;fontFamily=Helvetica;arcSize=8;fontStyle=1;fontColor=#18202C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1160" y="330" width="260" height="80" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;5 · OWNER decides&lt;/b&gt;&lt;br&gt;approve · defer · decline" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fontFamily=Helvetica;fillColor=#FFF2CC;strokeColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="1140" y="500" width="300" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;6 · O-25 Work Board&lt;/b&gt;&lt;br&gt;approved card becomes a board item, dispatched to its team lead" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EBF1;strokeColor=#4D5F7A;fontSize=11;fontFamily=Helvetica;arcSize=8;fontStyle=1;fontColor=#18202C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="860" y="720" width="300" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;7 · Team lead + team&lt;/b&gt;&lt;br&gt;runs the Shepherd's Way; daily status on the board" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEEDF;strokeColor=#C26A12;fontSize=11;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="480" y="730" width="280" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;8 · O-16 Decision Support&lt;/b&gt;&lt;br&gt;actual vs expected outcome; did the falsifier fire?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EBF1;strokeColor=#4D5F7A;fontSize=11;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="100" y="600" width="280" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;9 · O-10 Capsule Integrator&lt;/b&gt;&lt;br&gt;integrates the gap; nothing is lost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EBF1;strokeColor=#4D5F7A;fontSize=11;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="100" y="400" width="280" height="80" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="delivered" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="next scan starts higher" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="c11" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Deferred&lt;/b&gt;&lt;br&gt;O-24 re-proposes it at a later scan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=10;fontFamily=Helvetica;arcSize=8;dashed=1;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="1470" y="470" width="200" height="60" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Declined&lt;/b&gt;&lt;br&gt;reason logged; O-10 integrates it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=10;fontFamily=Helvetica;arcSize=8;dashed=1;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="1470" y="600" width="200" height="60" as="geometry"/></mxCell><mxCell id="c23" value="defer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="decline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;dashed=1;exitX=0.75;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Work Proposal card&lt;/b&gt;&lt;br&gt;&lt;br&gt;Project · Problem (which signal)&lt;br&gt;Proposed work&lt;br&gt;Owning team lead&lt;br&gt;Expected outcome (observable)&lt;br&gt;Falsifier: what would show it was wrong, and the threshold&lt;br&gt;Effort estimate (held as a range)&lt;br&gt;Dependency order / prerequisites&lt;br&gt;Open variables (named, not filled)&lt;br&gt;Human Gates it will need" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=11;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#4D5F7A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="380" height="240" as="geometry"/></mxCell><mxCell id="c26" value="Canon anchors: Layer V step 5 (lowest cell first) · Layer I.E step 8 (anticipate the next gradient) · Layer VII step 6 (lowest-conversion step) · Client Onboarding step 9 (next Fibonacci step) · Decision-Making steps 7–10 · Layer I.G. The loop itself is a derivation." style="text;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#5B6678;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c27" value="Derivation, not canon. Source: GFunnel Methodology (Omni Process) v5.1–v5.3, Cameron Garlick / GFunnel, github.com/GFunnel-Tech/methodology, CC BY 4.0. Adapted into an agent operating model; not endorsed by the author." style="text;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#5B6678;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="1000" width="1200" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5 · Team at Work — Newsletter"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1590" pageHeight="1088" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Team at Work — one newsletter issue through the Editorial &amp; Email team" style="text;html=1;fontSize=20;fontStyle=1;fontFamily=Helvetica;fontColor=#18202C;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c2" value="Columns are work-board states (the Shepherd's Way). Rows are agents. Numbered cards show the order; dashed arrows are status reports to the board and the Owner channel." style="text;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#5B6678;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Requested&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=10;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="230" y="120" width="159" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;01 Direct&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=10;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="395" y="120" width="159" height="34" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;02 Guide&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=10;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="159" height="34" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;03–04 Gather &amp; Organize&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=10;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="725" y="120" width="159" height="34" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;05 Create&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F6F8;strokeColor=#9AA5B5;fontSize=10;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="890" y="120" width="159" height="34" as="geometry"/></mxCell><mxCell id="c8" va