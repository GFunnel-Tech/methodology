<mxfile host="app.diagrams.net" type="device"><diagram id="p1" name="1 · Operating Model"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="GFunnel Agent Operating System" style="text;html=1;fontSize=20;fontStyle=1;fontFamily=Helvetica;fontColor=#18202C;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="700" height="30" as="geometry"/></mxCell><mxCell id="c2" value="How the team works, reports, talks to the Owner and suggests work. Everything reaches the Owner through one channel (O-23); every piece of work runs on one board (O-25) and the Shepherd's Way." style="text;html=1;fontSize=11;fontFamily=Helvetica;fontColor=#5B6678;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="42" width="640" height="40" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;OWNER&lt;/b&gt;&lt;br&gt;G-00 · Founder / Operator&lt;br&gt;&lt;i&gt;decides · names outcomes · supplies measurements&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2B3A55;strokeColor=#2B3A55;fontSize=12;fontFamily=Helvetica;arcSize=8;fontStyle=1;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="690" y="20" width="320" height="76" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;G-07&lt;/b&gt; · L&lt;br&gt;Founder Performance Agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3E8F1;strokeColor=#2B3A55;fontSize=10;fontFamily=Helvetica;arcSize=8;dashed=1;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="1080" y="30" width="220" height="56" as="geometry"/></mxCell><mxCell id="c5" value="weekly time review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5B6678;fontSize=10;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="c4"