" parent="1"><mxGeometry x="566" y="356" width="147" height="48" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;4&lt;/b&gt; Plan issue; pull proof, University, research" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=9;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="731" y="420" width="147" height="48" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;5&lt;/b&gt; Write feature section" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=9;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="896" y="484" width="147" height="48" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;6&lt;/b&gt; Write emails, subject lines, CTAs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=9;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="896" y="548" width="147" height="48" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;7&lt;/b&gt; Subtractive edit; fact-check; read aloud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=9;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="1061" y="612" width="147" height="48" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;8&lt;/b&gt; Brand voice + claims + attribution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=9;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="1061" y="676" width="147" height="48" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;G&lt;/b&gt; Only if a results claim needs approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B8860B;fontSize=9;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="1061" y="164" width="147" height="48" as="geometry"/></mxCell><mxCell id="c44" value="&lt;b&gt;9&lt;/b&gt; Approve against done-criterion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=9;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="1061" y="356" width="147" height="48" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;10&lt;/b&gt; Segment, test send, schedule in Lead Connector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=9;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="1226" y="740" width="147" height="48" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;11&lt;/b&gt; Document issue + send record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=9;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="1226" y="868" width="147" height="48" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;12&lt;/b&gt; 48 h / 7-day report; weakest step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=9;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="1391" y="804" width="147" height="48" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;13&lt;/b&gt; Retro; next issue starts higher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5B5;fontSize=9;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="1391" y="356" width="147" height="48" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;↑&lt;/b&gt; Results in the Owner Weekly Report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6EBF1;strokeColor=#4D5F7A;fontSize=9;fontFamily=Helvetica;arcSize=8;fontColor=#18202C;" vertex="1" parent="1"><mxGeometry x="1391" y="228" width="147" height="48" as="geometry"/></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rou